# Base URL of our own backend API. ApiClient prefixes every request with this.
API_URL=http://localhost:8080/api

# Supabase project credentials (Auth only). Find these in Project Settings > API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Google Maps JavaScript API key. Enables the map location picker on the client
# form. Optional — the form still accepts manual coordinates without it.
# Restrict the key by HTTP referrer in Google Cloud Console.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_JS_API_KEY

# Google Maps Map ID — required by Advanced Markers. Create one under
# Google Maps Platform > Map Management. Leave empty to use Google's
# DEMO_MAP_ID (fine for prototyping, not for production).
MAPS_MAP_ID=

# Firebase web app config. Find these in Firebase Console > Project settings >
# General > Your apps > SDK setup and configuration. These values are public by
# design (they identify the project, they do not grant access) — access is
# controlled by Storage and Realtime Database security rules.
FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID
# Optional — only needed if Analytics is enabled.
FIREBASE_MEASUREMENT_ID=
